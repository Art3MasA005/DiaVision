# Copy to backend/.env and fill in. NEVER commit .env — it is gitignored.
#
# Local development points at the PostgreSQL 18 instance on port 5432.
# (A PostgreSQL 14 instance also runs on this machine, on port 5433. Use 18.)
#
# Staging and production override DATABASE_URL only; nothing else changes.

# ── database ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=byebye_dev
POSTGRES_USER=byebye_app
POSTGRES_PASSWORD=change-me

# The superuser is used ONLY by scripts/setup_db.py to create the role and
# database. The application never connects as superuser — a superuser bypasses
# row-level security entirely, which would silently void every isolation
# guarantee in PRD §18.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# ── auth ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# ── language model (OpenRouter) ──────────────────────────
# Used by the AI coach and the camera calorie estimate. Leave the key empty to
# run without a model: the coach answers with fixed wording, the camera falls
# back to manual entry. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash

# ── email (password reset codes) ─────────────────────────
# Leave SMTP_HOST empty in development: the 6-digit code is written to the
# server log instead. In production an empty host makes reset answer 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ── app ──────────────────────────────────────────────────
ENVIRONMENT=development
DEFAULT_REGION=bd
LOG_LEVEL=INFO
