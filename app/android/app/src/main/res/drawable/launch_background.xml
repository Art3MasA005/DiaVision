<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen (before Android 12): the sage ground with the Clear
     Lens tile, so the first Flutter frame (the splash) follows without a
     white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
